# ── Required ───────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here           # Get free at console.groq.com
JWT_SECRET=generate_with_python_secrets_32chars # python -c "import secrets; print(secrets.token_hex(32))"

# ── Database (PostgreSQL) ──────────────────────────────────────────────────────
# Docker (auto-configured via docker-compose environment block):
#   DATABASE_URL=postgresql://askmynotes:askmynotes@postgres:5432/askmynotes
# Local dev without Docker:
DATABASE_URL=postgresql://askmynotes:askmynotes@localhost:5432/askmynotes

# ── Cache (Redis) ──────────────────────────────────────────────────────────────
# Docker (auto-configured via docker-compose environment block):
#   REDIS_URL=redis://redis:6379/0
# Local dev without Docker:
REDIS_URL=redis://localhost:6379/0
# Answer cache TTL in seconds (default: 3600 = 1 hour)
ANSWER_CACHE_TTL=3600

# ── CORS — comma-separated list of allowed frontend origins ────────────────────
ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com

# ── Optional — LLM ────────────────────────────────────────────────────────────
GROQ_MODEL=llama-3.1-8b-instant               # Model to use (can also use llama-3.3-70b-versatile)

# ── Optional — Google OAuth ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_oauth_client_id

# ── Optional — YouTube video search ───────────────────────────────────────────
YOUTUBE_API_KEY=your_youtube_api_key_here

# ── Optional — Storage paths (useful for Render persistent disk) ───────────────
CHROMA_DIR=chroma_db

# ── Optional — Observability ──────────────────────────────────────────────────
SENTRY_DSN=https://xxx@sentry.io/xxx          # Create free project at sentry.io
SENTRY_TRACES_RATE=0.2                         # 20% of requests traced

# ── Optional — App metadata ────────────────────────────────────────────────────
ENVIRONMENT=development                        # development | production
APP_VERSION=dev                                # shown in /health and Sentry

# ── Optional — Docker workers ──────────────────────────────────────────────────
WORKERS=1                                      # Uvicorn workers (set 2-4 in prod)

# ── Cloudinary (for cloud file storage — optional but recommended for production)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
