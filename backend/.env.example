# Required
GROQ_API_KEY=your_groq_api_key_here        # Get free at console.groq.com
JWT_SECRET=a_long_random_secret_32chars_min  # Any random string, 32+ chars

# Optional
GOOGLE_CLIENT_ID=your_google_oauth_client_id  # For Google sign-in
YOUTUBE_API_KEY=your_youtube_api_key_here     # For video recommendations
CHROMA_DIR=chroma_db                          # ChromaDB storage path
DB_PATH=askmynotes.db                         # SQLite path
